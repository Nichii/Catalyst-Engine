<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <XDKEditionTarget>260403</XDKEditionTarget>
    <gdk_root>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)\..\native'))</gdk_root>
  </PropertyGroup>

  <!--
  ****************************************************************************************************
  Properties for Gaming.Desktop.x64
  ****************************************************************************************************
  -->
  <PropertyGroup Condition="'$(Platform)' == 'Gaming.Desktop.x64'">
    <DurangoXdkInstallPath>$(gdk_root)\</DurangoXdkInstallPath>
    <GDKCrossPlatform>true</GDKCrossPlatform>
  </PropertyGroup>

  <!--
  ****************************************************************************************************
  Properties that are OK for use with any platform
  ****************************************************************************************************
  -->
  <PropertyGroup>
    <GameDKCoreLatest>$(gdk_root)\$(XDKEditionTarget)\</GameDKCoreLatest>
  </PropertyGroup>

</Project>
