<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <XDKEditionTarget>260403</XDKEditionTarget>
    <gdk_root>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)\..\native'))</gdk_root>
  </PropertyGroup>

  <!--
  ****************************************************************************************************
  Properties for Gaming.*.x64
  ****************************************************************************************************
  -->
  <PropertyGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Platform)', 'Gaming\..+\.x64'))">
    <DurangoXdkTools>$(gdk_root)\bin\</DurangoXdkTools>
  </PropertyGroup>

  <!--
  ****************************************************************************************************
  Properties that are OK for use with any platform
  ****************************************************************************************************
  -->
  <PropertyGroup>
    <GameDK>$(gdk_root)\</GameDK>
  </PropertyGroup>
</Project>
